diff --git a/css/xp.css b/css/xp.css
index 814a0ee..08b4587 100644
--- a/css/xp.css
+++ b/css/xp.css
@@ -754,3 +754,30 @@ body
 	animation-fill-mode: forwards;
 	animation-timing-function: steps(16, end);
 }
+
+/*
+ * Fingerprint reader hint.
+ *
+ * Replaces the "Type your password" text above the password box while
+ * pam_fprintd is waiting for a scan, instead of dumping the raw PAM
+ * message into the header bar.
+ */
+.password-msg.fingerprint,
+.password-msg.fingerprint-error
+{
+    padding-left: 18px;
+    background-repeat: no-repeat;
+    background-position: left center;
+    background-size: 14px 14px;
+}
+
+.password-msg.fingerprint
+{
+    background-image: url("../img/fingerprint.svg");
+}
+
+.password-msg.fingerprint-error
+{
+    color: #ffb3b3;
+    background-image: url("../img/fingerprint-error.svg");
+}
